# =============================================================================
# Colosseum environment configuration (example)
# Copy to `.env` and fill in. Never commit a real `.env`.
#
# Credentials are REUSED from the sibling superclaims-ai / healthpay-ai projects.
# Rather than copy secrets, point Colosseum at the existing dotenv files and/or
# the existing Google service-account JSON. The config loader (core/config.py)
# layers these external files in, then this `.env` overrides on top.
# =============================================================================

# ---- App ----
COLOSSEUM_ENV=local
LOG_LEVEL=INFO

# ---- Database (matches docker-compose.yml; note non-default host ports) ----
DATABASE_URL=postgresql+psycopg://colosseum:colosseum@localhost:5433/colosseum

# ---- Redis ----
REDIS_URL=redis://localhost:6380/0

# ---- External dotenv files to layer in (reused creds; read-only) ----
# Absolute paths to the sibling projects' env files. Leave blank to disable.
EXTERNAL_ENV_FILES=/Users/ekincare/superclaims/superclaims-ai/.env,/Users/ekincare/superclaims/healthpay-ai/healthpay/backend/.env

# ---- Google / Vertex AI ----
# Path to the service-account JSON used by superclaims-ai (Application Default
# Credentials). LiteLLM's vertex_ai provider reads GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_APPLICATION_CREDENTIALS=
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=us-central1

# Default Gemini model id used for the Phase-1 vertical slice.
# Use the exact model string already in use on the project's Vertex.
COLOSSEUM_DEFAULT_GEMINI_MODEL=vertex_ai/gemini-2.5-flash
JUDGE_DEFAULT_MODEL=gemini-3.1-pro

# ---- AWS Bedrock ----
# Use IAM Access Key & Secret Key for continuous auto-renewing SigV4 authentication (recommended).
# Or pass an optional AWS_BEARER_TOKEN_BEDROCK (expires after ~12 hours).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1
AWS_BEARER_TOKEN_BEDROCK=

# ---- Self-deployed Qwen3-VL-8B (vLLM / OpenAI-compatible) ----
QWEN_VL_BASE_URL=http://15.252.27.168:8000/v1
QWEN_VL_API_KEY=EMPTY

# ---- OpenRouter (fronts OpenAI/Anthropic/Google/Meta/... behind one key) ----
# Get a key at https://openrouter.ai/keys. Needs credits to invoke models.
OPENROUTER_API_KEY=

# ---- Pricing / rate card ----
PRICING_VERSION=2026-06

# ---- Observability (Langfuse) — wired in Phase 4 ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
